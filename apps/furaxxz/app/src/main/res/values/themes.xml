<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FuraxXZ" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/furax_primary</item>
        <item name="colorPrimaryDark">@color/furax_primary_dark</item>
        <item name="colorAccent">@color/furax_accent</item>
        <item name="android:windowBackground">@color/furax_background</item>
        <item name="colorSurface">@color/furax_surface</item>
        <item name="colorOnSurface">@color/furax_on_background</item>
    </style>

    <!-- Used only by LauncherActivity: shows the real system wallpaper
         behind the home screen (android:windowShowWallpaper), instead of
         a flat background color. -->
    <style name="Theme.FuraxXZ.Launcher" parent="Theme.FuraxXZ">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>
</resources>
